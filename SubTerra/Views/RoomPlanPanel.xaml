<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SubTerra.Views.RoomPlanPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Помещения и этажи" Style="{StaticResource Section}" Margin="0,0,0,10" />
        <ComboBox ItemsSource="{Binding SavedRooms}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedRoomId}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="Комната проекта" Margin="0,0,0,8">
            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ComboBox.Style>
        </ComboBox>
        <TextBlock Text="{Binding RoomSummary}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
        <StackPanel Visibility="{Binding RoomPlanVisible, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding RoomAreaText}" FontSize="28" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding RoomPerimeterText, StringFormat=Периметр: {0}}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding RoomHeightText, StringFormat=Высота: {0}}" Margin="0,4,0,12" TextWrapping="Wrap" />
            <Button Content="Открыть план →" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="План 2D" Style="{StaticResource Primary}" />
            <Button Content="Свойства комнаты" Command="{Binding InspectCommand}" CommandParameter="Комната" Style="{StaticResource Ghost}" Margin="0,5,0,8" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasRoomPlanInputs, Converter={StaticResource BoolVisibility}}">
        <Button Content="Построить / обновить план" Command="{Binding BuildRoomCommand}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding RoomBuildMessage}" Foreground="#F2C2A8" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        <Expander Header="Параметры комнаты" Margin="0,10,0,0"><StackPanel Margin="0,10,0,0">
        <TextBlock Text="{Binding RoomsSummary}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
        <Button Content="+ Новая комната" Command="{Binding NewRoomCommand}" Margin="0,0,0,12" />
        <TextBlock Text="Название" Style="{StaticResource Label}" Margin="0,0,0,6" />
        <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBuildRoom}" MaxLength="80" AutomationProperties.Name="Название комнаты" />
        <TextBlock Text="Этаж / уровень" Style="{StaticResource Label}" Margin="0,10,0,6" />
        <TextBox Text="{Binding RoomFloor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBuildRoom}" MaxLength="80" AutomationProperties.Name="Этаж комнаты" />
        <Button Content="Применить название и этаж" Command="{Binding ApplyRoomIdentityCommand}" Margin="0,8,0,0" />
        <Expander Header="Поверхности этой комнаты" Margin="0,10,0,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding RoomSurfaceChoices}" IsEnabled="{Binding CanBuildRoom}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="12" Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Использовать точку внутри комнаты" IsChecked="{Binding UseRoomInteriorPoint}" IsEnabled="{Binding CanBuildRoom}" FontSize="12" Margin="0,9,0,0" />
                <Button Content="Выбрать точку в 3D" Command="{Binding CoordinatesCommand}" FontSize="12" Margin="0,6,0,0" />
                <TextBlock Text="При общем полу выберите внутреннюю точку и стены нужного помещения." Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
        </Expander>
        </StackPanel></Expander>
        </StackPanel>
        <Button Command="{Binding OpenRoomPlanNextStepCommand}" Content="{Binding RoomPlanNextAction}" Margin="0,0,0,6">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions><Condition Binding="{Binding HasRoomPlanInputs}" Value="False"/><Condition Binding="{Binding RoomPlanVisible}" Value="False"/></MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Expander Header="Связи и содержимое комнат" Margin="0,12,0,0" Visibility="{Binding HasRoom, Converter={StaticResource BoolVisibility}}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding RoomWarnings}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding RoomConnectionsText}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding RoomObjectMembershipText}" Style="{StaticResource Muted}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
