<UserControl x:Class="SubTerra.Views.RoomPlanPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="0,16,4,8"><StackPanel>
        <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="↶" Style="{StaticResource Ghost}" Width="28" Height="28" MinHeight="28" Padding="0" FontSize="16" Command="{Binding UndoProjectCommand}" ToolTip="{Binding UndoProjectText}" AutomationProperties.Name="Отменить действие"/>
            <Button Content="↷" Style="{StaticResource Ghost}" Width="28" Height="28" MinHeight="28" Padding="0" FontSize="16" Command="{Binding RedoProjectCommand}" ToolTip="{Binding RedoProjectText}" AutomationProperties.Name="Повторить действие"/>
        </StackPanel><TextBlock Text="Помещения и этажи" Style="{StaticResource Section}" VerticalAlignment="Center"/></DockPanel>
        <ComboBox ItemsSource="{Binding SavedRooms}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedRoomId}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="Комната проекта" Margin="0,0,0,7"/>
        <TextBlock Text="{Binding RoomsSummary}" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
        <Button Content="+ Новая комната" Command="{Binding NewRoomCommand}" FontSize="11" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding RoomSummary}" Style="{StaticResource Muted}"/>
        <TextBlock Text="Название комнаты" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
        <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBuildRoom}" MaxLength="80" AutomationProperties.Name="Название комнаты"/>
        <TextBlock Text="Этаж или уровень" Style="{StaticResource Muted}" Margin="0,8,0,5"/>
        <TextBox Text="{Binding RoomFloor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBuildRoom}" MaxLength="80" AutomationProperties.Name="Этаж комнаты"/>
        <Button Content="Применить название и этаж" Command="{Binding ApplyRoomIdentityCommand}" FontSize="11" Margin="0,6,0,0"/>
        <Expander Header="Поверхности этой комнаты" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding RoomSurfaceChoices}" IsEnabled="{Binding CanBuildRoom}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="11" Margin="0,0,0,6"/>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        <CheckBox Content="Использовать точку внутри комнаты" IsChecked="{Binding UseRoomInteriorPoint}" IsEnabled="{Binding CanBuildRoom}" FontSize="11" Margin="0,9,0,0"/>
        <Button Content="Выбрать точку в 3D" Command="{Binding CoordinatesCommand}" FontSize="11" Margin="0,6,0,0"/>
        <TextBlock Text="Если пол общий для нескольких помещений, выберите точку внутри нужного контура и только его стены." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Button Content="Построить / обновить план" Command="{Binding BuildRoomCommand}" Style="{StaticResource Primary}" FontSize="11" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding RoomBuildMessage}" Foreground="#F2C2A8" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
        <TextBlock Text="Построение доступно администратору. Сначала подтвердите поверхности в соседней вкладке." Style="{StaticResource Muted}" Margin="0,4,0,10"/>
        <StackPanel Visibility="{Binding HasRoom, Converter={StaticResource BoolVisibility}}">
            <Border Style="{StaticResource InsetCard}" Margin="0,6,0,12"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Площадь плана" Style="{StaticResource Muted}" Margin="0,0,6,10"/><TextBlock Grid.Column="1" Text="{Binding RoomAreaText}" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Grid.Row="1" Text="Периметр" Style="{StaticResource Muted}" Margin="0,0,6,10"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RoomPerimeterText}"/>
                <TextBlock Grid.Row="2" Text="Высота" Style="{StaticResource Muted}" Margin="0,0,6,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoomHeightText}" TextWrapping="Wrap" MaxWidth="148"/>
            </Grid></Border>
            <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12" Visibility="{Binding RoomPlanVisible, Converter={StaticResource BoolVisibility}}"><StackPanel>
                <TextBlock Text="Вид сверху · север не задан" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                <Viewbox Stretch="Uniform" MaxHeight="160"><Canvas Width="240" Height="140" Background="#0B151E">
                    <Polygon Points="{Binding RoomPlanPoints}" Stroke="#A1E3C5" StrokeThickness="1.7" Fill="#1C3144"/>
                    <Path Data="{Binding RoomPlanGaps}" Stroke="#FFB46B" StrokeThickness="4"/>
                </Canvas></Viewbox>
            </StackPanel></Border>
            <CheckBox Content="Границы комнаты в 3D" IsChecked="{Binding ShowRoom}" Margin="0,0,0,12"/>
            <CheckBox Content="Показать все актуальные комнаты" IsChecked="{Binding ShowAllRooms}" Margin="0,0,0,10" FontSize="11"/>
            <TextBlock Text="{Binding RoomConnectionsText}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding RoomObjectMembershipText}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <Expander Header="Коррекция контура и проёмов" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0">
                <StackPanel IsEnabled="{Binding CanEditRoom}">
                    <ComboBox ItemsSource="{Binding RoomVertices}" SelectedIndex="{Binding RoomVertexIndex, Mode=TwoWay}" DisplayMemberPath="Label" AutomationProperties.Name="Вершина комнаты"/>
                    <TextBlock Text="Координаты X и Y, м" Style="{StaticResource Muted}" Margin="0,8,0,5"/>
                    <UniformGrid Columns="2"><TextBox Text="{Binding RoomVertexX, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Координата X вершины" Margin="0,0,4,0"/><TextBox Text="{Binding RoomVertexY, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Координата Y вершины"/></UniformGrid>
                    <Button Content="Применить координаты" Command="{Binding ApplyRoomVertexCommand}" FontSize="11" Margin="0,6,0,0"/>
                    <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="Добавить после" Command="{Binding InsertRoomVertexCommand}" FontSize="10" Margin="0,0,4,0"/><Button Content="Удалить вершину" Command="{Binding RemoveRoomVertexCommand}" FontSize="10"/></UniformGrid>
                    <TextBlock Text="Новая вершина вставляется в середину следующего ребра. Контур должен оставаться выпуклым, без пересечений." Style="{StaticResource Muted}" Margin="0,6,0,10"/>
                    <TextBlock Text="Проём на ребре от выбранной вершины: начало и конец, м" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                    <UniformGrid Columns="2"><TextBox Text="{Binding RoomOpeningStart, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Начало проёма в метрах" Margin="0,0,4,0"/><TextBox Text="{Binding RoomOpeningEnd, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Конец проёма в метрах"/></UniformGrid>
                    <Button Content="Добавить проём" Command="{Binding AddRoomOpeningCommand}" FontSize="11" Margin="0,6,0,8"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RoomOpenings}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="×" Padding="7,3" Command="{Binding DataContext.RemoveRoomOpeningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Удалить проём или разрыв"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Content="Вернуть автоматический контур" Command="{Binding ResetRoomEditsCommand}" FontSize="11" Margin="0,6,0,0"/>
                <TextBlock Text="Все правки сохраняются и поддерживают отмену. Пересчёт не заменит ручной контур без явного возврата к автоматическому." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel></Expander>
            <TextBlock Text="{Binding RoomWarnings}" Style="{StaticResource Muted}"/>
            <Button Content="Удалить план комнаты" Command="{Binding RemoveRoomCommand}" Style="{StaticResource Ghost}" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
