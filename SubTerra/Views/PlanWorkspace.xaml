<UserControl Foreground="{DynamicResource TextBrush}" x:Class="SubTerra.Views.PlanWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SubTerra.Views">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid><Grid Background="#0C161F" Visibility="{Binding IsRoomMode, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="12,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding RoomPlanVisible, Converter={StaticResource BoolVisibility}}">
                <Button Content="−" Click="ZoomOut_Click" Padding="9,4" Style="{StaticResource Ghost}" ToolTip="Отдалить план" AutomationProperties.Name="Отдалить план"/>
                <Button Content="+" Click="ZoomIn_Click" Padding="9,4" Style="{StaticResource Ghost}" ToolTip="Приблизить план" AutomationProperties.Name="Приблизить план"/>
                <Button Content="Вписать" Click="Fit_Click" Padding="9,4" Style="{StaticResource Ghost}"/>
            </StackPanel>
            <TextBlock Text="План помещения" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <views:RoomPlanCanvas x:Name="PlanCanvas" Grid.Row="1" Plan="{Binding CurrentRoomPlan}" SelectedVertexIndex="{Binding RoomVertexIndex, Mode=TwoWay}" SelectionChosen="Plan_SelectionChosen" AutomationProperties.Name="Метрический план комнаты"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RoomPlanVisible}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="План ещё не построен"/><Style.Triggers><DataTrigger Binding="{Binding RoomIsStale}" Value="True"><Setter Property="Text" Value="План нужно обновить"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding RoomPlanEmptyHint}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,14"/>
            <Button Content="{Binding RoomPlanNextAction}" Command="{Binding OpenRoomPlanNextStepCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="14,9" Visibility="{Binding RoomPlanVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding SelectionText, ElementName=PlanCanvas}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Голубой — проём оператора. Оранжевый — возможный проём." ToolTip="Колесо — масштаб · ПКМ — перемещение" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
    </Grid>
    <Grid Background="#0C161F" Visibility="{Binding IsTunnelMode, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16,12"><TextBlock Text="Поперечное сечение" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding TunnelSections}" SelectedItem="{Binding SelectedTunnelSection}" DisplayMemberPath="Title" HorizontalAlignment="Left" MinWidth="185" MaxWidth="280" Visibility="{Binding HasTunnelSections, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Выбор поперечного сечения" Margin="0,10,0,0"/>
        </StackPanel>
        <views:TunnelSectionCanvas Grid.Row="1" Section="{Binding CurrentTunnelSection}" MaximumContourGap="{Binding TunnelContourGap}" Visibility="{Binding HasTunnelSections, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Большой профиль тоннеля"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="24">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTunnelSections}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Нет актуального сечения" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Задайте ось тоннеля и рассчитайте сечения по точкам скана." Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,14"/>
            <Button HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                        <Setter Property="Content" Value="К анализу тоннеля"/>
                        <Setter Property="Command" Value="{Binding SelectAnalysisToolCommand}"/>
                        <Setter Property="CommandParameter" Value="Тоннель"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsGuest}" Value="True"><Setter Property="Content" Value="Войти для расчёта"/><Setter Property="Command" Value="{Binding RequestAdminAccessCommand}"/></DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="16,10" Visibility="{Binding HasTunnelSections, Converter={StaticResource BoolVisibility}}"><StackPanel>
            <TextBlock Text="{Binding TunnelSectionMetrics}" TextWrapping="Wrap"/>
            <TextBlock Text="Голубая точка — ось. Разрывы между измеренными участками оставлены открытыми." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel></Border>
    </Grid></Grid>
</UserControl>
