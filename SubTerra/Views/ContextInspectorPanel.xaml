<UserControl Foreground="{DynamicResource TextBrush}" x:Class="SubTerra.Views.ContextInspectorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SubTerra.Views">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="16,4,16,16"><StackPanel>
        <views:ScanPropertiesPanel Visibility="{Binding ShowScanInspector, Converter={StaticResource BoolVisibility}}"/>
        <views:SurfacePropertiesPanel Visibility="{Binding ShowSurfaceInspector, Converter={StaticResource BoolVisibility}}"/>
        <views:ObjectPropertiesPanel Visibility="{Binding ShowObjectInspector, Converter={StaticResource BoolVisibility}}"/>
        <StackPanel Visibility="{Binding ShowRoomInspector, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding RoomName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <views:RoomEditingPanel Visibility="{Binding HasRoom, Converter={StaticResource BoolVisibility}}"/>
            <TextBlock Text="{Binding RoomSummary}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="ПЛОЩАДЬ" Style="{StaticResource Label}"/><TextBlock Text="{Binding RoomAreaText}" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,16"/>
            <TextBlock Text="ПЕРИМЕТР" Style="{StaticResource Label}"/><TextBlock Text="{Binding RoomPerimeterText}" FontSize="18" Margin="0,6,0,16"/>
            <TextBlock Text="ВЫСОТА" Style="{StaticResource Label}"/><TextBlock Text="{Binding RoomHeightText}" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <TextBlock Text="{Binding RoomWarnings}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding RoomFloor}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
            <Button Content="Открыть план 2D" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="План 2D" Style="{StaticResource Primary}"/>
            <Button Content="Удалить план комнаты" Command="{Binding RemoveRoomCommand}" Style="{StaticResource Danger}" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Visibility="{Binding ShowSimulationInspector, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding SelectedScenario.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Синтетическая сцена" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SelectedScenario.Description}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            <TextBlock Text="{Binding TotalLengthText}" FontSize="22" Margin="0,12,0,4"/>
            <TextBlock Text="Длина маршрута · не реальные измерения" Style="{StaticResource Muted}"/>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
