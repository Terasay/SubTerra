<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SubTerra.Views.SessionInspectorPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Expander Header="Измерения и метки" IsExpanded="True">
            <StackPanel Margin="0,8,0,0">
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Координаты" Command="{Binding CoordinatesCommand}" FontSize="11" Margin="0,0,5,0" />
                    <Button Content="Расстояние" Command="{Binding MeasureCommand}" FontSize="11" />
                </UniformGrid>
                <TextBlock Text="{Binding PickedCoordinates}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding SourceCoordinates}" Style="{StaticResource Muted}" Margin="0,5,0,0" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}" />
                <Border Style="{StaticResource InsetCard}" Margin="0,9,0,12" Padding="10">
                    <TextBlock Text="{Binding MeasurementText}" TextWrapping="Wrap" Foreground="#A9E6F3" />
                </Border>
                <TextBlock Text="Название метки" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding AnnotationName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Название своей метки" />
                <Button Command="{Binding AddAnnotationCommand}" Content="Добавить метку" Margin="0,7,0,0" ToolTip="Сначала выберите координаты на карте. Для записи метки нужен администратор." />
                <TextBlock Text="Свои метки сохраняются в проекте. Добавление доступно администратору." Style="{StaticResource Muted}" Margin="0,8,0,10" />
                <ItemsControl ItemsSource="{Binding UserAnnotations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="×" Padding="10,6" Margin="5,0,0,0" Command="{Binding DataContext.RemoveAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Удалить метку" />
                                <Button HorizontalContentAlignment="Left" Padding="10,6" Command="{Binding DataContext.NavigateAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
        <Expander Header="Места в сценарии" Margin="0,12,0,0" Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Выберите место, чтобы переместить камеру." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding VisibleMarkers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MarkerButton}" Command="{Binding DataContext.NavigateMarkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
        <TextBlock Text="Сохранение и экспорт" Style="{StaticResource Section}" Margin="0,0,0,10" />
        <Button Click="SaveAs_Click" IsEnabled="{Binding CanSave}" Content="Сохранить как…" ToolTip="Создать отдельный файл · Ctrl+Shift+S" Margin="0,0,0,7" />
        <Button Click="Export_Click" IsEnabled="{Binding CanExport}" Content="{Binding ExportButtonText}" ToolTip="Экспорт видимых объектов после очистки. Качество просмотра не влияет." />
        <TextBlock Text="Для записи и экспорта войдите администратором." Style="{StaticResource Muted}" Margin="0,9,0,0" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}" />
        <Expander Header="Журнал событий" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Muted}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </StackPanel>
</UserControl>
