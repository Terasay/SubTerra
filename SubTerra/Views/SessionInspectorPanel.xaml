<UserControl x:Class="SubTerra.Views.SessionInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    </ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="16,0,12,16"><StackPanel>
        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="ТЕКУЩИЙ СЕАНС" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding SessionTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding SessionSaveLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,12" TextWrapping="Wrap" FontSize="11"/>
            <TextBlock Text="{Binding ImportTransformText}" Style="{StaticResource Muted}" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
            <Grid Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7"><TextBlock Text="Длина маршрута" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalLengthText}" HorizontalAlignment="Right"/></Grid>
            <Grid Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7"><TextBlock Text="Кадры" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FrameCountText}" HorizontalAlignment="Right"/></Grid>
            <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Muted}"/>
        </StackPanel></Border>
        <Expander Header="Измерения и метки" IsExpanded="True"><StackPanel Margin="0,8,0,0">
            <UniformGrid Columns="2" Margin="0,0,0,10"><Button Content="Координаты" Command="{Binding CoordinatesCommand}" FontSize="11" Margin="0,0,5,0"/><Button Content="Расстояние" Command="{Binding MeasureCommand}" FontSize="11"/></UniformGrid>
            <TextBlock Text="{Binding PickedCoordinates}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding SourceCoordinates}" Style="{StaticResource Muted}" Margin="0,5,0,0" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
            <Border Style="{StaticResource InsetCard}" Margin="0,9,0,12" Padding="10"><TextBlock Text="{Binding MeasurementText}" TextWrapping="Wrap" Foreground="#A9E6F3"/></Border>
            <TextBlock Text="Название метки" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding AnnotationName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Название своей метки"/>
            <Button Command="{Binding AddAnnotationCommand}" Content="Добавить метку" Margin="0,7,0,0" ToolTip="Сначала выберите координаты на карте. Для записи метки нужен администратор."/>
            <TextBlock Text="Свои метки сохраняются в проекте. Добавление доступно администратору." Style="{StaticResource Muted}" Margin="0,8,0,10"/>
            <ItemsControl ItemsSource="{Binding UserAnnotations}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="×" Padding="10,6" Margin="5,0,0,0" Command="{Binding DataContext.RemoveAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Удалить метку"/>
                <Button HorizontalContentAlignment="Left" Padding="10,6" Command="{Binding DataContext.NavigateAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></Button>
            </DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Expander>
        <Expander Header="Срез облака" Margin="0,12,0,0" IsEnabled="{Binding IsPoints}"><StackPanel Margin="0,8,0,0">
            <CheckBox Content="Включить срез" IsChecked="{Binding ClipEnabled}"/>
            <Grid Margin="0,12,0,0"><TextBlock Text="Азимут"/><TextBlock Text="{Binding ClipYaw, StringFormat={}{0:F0}°}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></Grid>
            <Slider Value="{Binding ClipYaw, Delay=100}" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Азимут среза"/>
            <Grid><TextBlock Text="Наклон"/><TextBlock Text="{Binding ClipPitch, StringFormat={}{0:F0}°}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></Grid>
            <Slider Value="{Binding ClipPitch, Delay=100}" Minimum="-90" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Наклон среза"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Смещение, м" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ClipOffset, UpdateSourceTrigger=LostFocus}" KeyDown="NumericInput_KeyDown" AutomationProperties.Name="Смещение плоскости"/></Grid>
            <Slider Value="{Binding ClipOffset, Delay=100}" Minimum="{Binding ClipMinimum}" Maximum="{Binding ClipMaximum}" TickFrequency="{Binding ClipStep}" IsSnapToTickEnabled="True" AutomationProperties.Name="Смещение среза"/>
            <TextBlock Text="Срез меняет только просмотр. Полный скан сохраняется и экспортируется целиком." Style="{StaticResource Muted}"/>
        </StackPanel></Expander>
        <Expander Header="Места в сценарии" Margin="0,12,0,0" Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,8,0,0">
            <TextBlock Text="Выберите место, чтобы переместить камеру." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding VisibleMarkers}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource MarkerButton}" Command="{Binding DataContext.NavigateMarkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Expander>
        <StackPanel Visibility="{Binding IsHeight, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
            <TextBlock Text="Шкала высоты" Style="{StaticResource Section}" Margin="0,0,0,10"/>
            <Border Height="7" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1B5186" Offset="0"/><GradientStop Color="#12BACA" Offset=".2"/><GradientStop Color="#27D48A" Offset=".4"/><GradientStop Color="#90E845" Offset=".6"/><GradientStop Color="#EADD38" Offset=".8"/><GradientStop Color="#F78C2E" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Grid Margin="0,7,0,0"><TextBlock Text="{Binding HeightMinText}" FontSize="11"/><TextBlock Text="{Binding HeightMaxText}" FontSize="11" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
        <Border Style="{StaticResource Divider}"/>
        <TextBlock Text="Файл проекта" Style="{StaticResource Section}" Margin="0,0,0,10"/>
        <Button Click="SaveAs_Click" IsEnabled="{Binding CanSave}" Content="Сохранить как…" ToolTip="Создать отдельный файл · Ctrl+Shift+S" Margin="0,0,0,7"/>
        <Button Click="Export_Click" IsEnabled="{Binding CanExport}" Content="{Binding ExportButtonText}" ToolTip="Экспорт видимых объектов после очистки. Качество просмотра не влияет."/>
        <TextBlock Text="Для записи и экспорта войдите администратором." Style="{StaticResource Muted}" Margin="0,9,0,0" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}"/>
        <Expander Header="Недавние проекты" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding RecentSessions}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
            <Button Content="{Binding Name}" ToolTip="{Binding Path}" FontSize="11" Padding="10" HorizontalContentAlignment="Left" Margin="0,0,0,6" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        <Expander Header="Журнал событий" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Muted}"/></Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
    </StackPanel></ScrollViewer>
</UserControl>
