<UserControl x:Class="SubTerra.Views.StructureAnalysisPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="AnalyzeAction" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Content" Value="Найти поверхности"/><Style.Triggers><DataTrigger Binding="{Binding HasStructureAnalysis}" Value="True"><Setter Property="Background" Value="#1B2B37"/><Setter Property="Foreground" Value="#DAE5EF"/><Setter Property="BorderBrush" Value="#354A59"/><Setter Property="Content" Value="Повторить поиск поверхностей"/></DataTrigger></Style.Triggers></Style></ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="0,4,4,12"><StackPanel>
        <TextBlock Text="Анализ помещения" Style="{StaticResource Section}" Margin="0,0,0,12"/>
        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="{Binding AnalysisProgressText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding NextAnalysisStep}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="01  Обнаружить и классифицировать" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Поиск плоскостей и предварительные классы. Метод классификации — в параметрах." Style="{StaticResource Muted}" Margin="0,6,0,12"/>
        <Button Command="{Binding AnalyzeStructureCommand}" Style="{StaticResource AnalyzeAction}" ToolTip="Новый анализ заменяет предыдущий. Изменение можно отменить."/>
        <Expander Header="Параметры поиска" Margin="0,10,0,16"><StackPanel Margin="0,10,0,0">
            <TextBlock Text="{Binding StructureTolerance, StringFormat=Допуск плоскости: {0:F3} м}" Style="{StaticResource Muted}"/>
            <Slider Minimum=".005" Maximum=".1" TickFrequency=".005" IsSnapToTickEnabled="True" Value="{Binding StructureTolerance}" IsEnabled="{Binding CanAnalyzeStructure}" AutomationProperties.Name="Допуск анализа плоскостей"/>
            <CheckBox Content="Экспериментальные классы MLP" IsChecked="{Binding UseNeuralClasses}" IsEnabled="{Binding CanAnalyzeStructure}" Margin="0,8,0,8"/>
            <TextBlock Text="MLP обучена на синтетических признаках. Оценка модели — не измеренная точность. Предметы и двери сеть не распознаёт." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <Button Content="Найти и подготовить 3D" Command="{Binding AnalyzeIndoorCommand}" ToolTip="Поиск с MLP и построение предварительных поверхностей для осмотра" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding StructureDataText}" Style="{StaticResource Muted}"/>
        </StackPanel></Expander>
        <TextBlock Text="{Binding SurfaceAnalysisMethodText}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        <TextBlock Text="02  Проверить результаты" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding ReviewProgressText}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
        <ListBox ItemsSource="{Binding StructureSurfaces}" SelectedItem="{Binding SelectedStructureSurface}" SelectionChanged="Surface_SelectionChanged" Background="Transparent" BorderThickness="0" MinHeight="80" AutomationProperties.Name="Кандидаты поверхностей">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Свойства выбранной поверхности →" Command="{Binding InspectCommand}" CommandParameter="Поверхность" Margin="0,6,0,8"/>
        <CheckBox Content="Подсвечивать классы в сцене" IsChecked="{Binding ShowStructure}" Margin="0,0,0,16"/>
        <TextBlock Text="03  Получить план комнаты" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Button Content="Далее: результаты →" Command="{Binding SelectSectionCommand}" CommandParameter="Результаты"/>
        <TextBlock Text="{Binding StructureSummary}" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="{Binding StructureIsStale, Converter={StaticResource BoolVisibility}}"/>
        <Expander  Header="Предметы · геометрические группы" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding ObjectCandidatesSummary}" Style="{StaticResource Muted}" Margin="0,8,0,10" />
        <StackPanel IsEnabled="{Binding CanAnalyzeObjects}">
            <TextBlock Text="Размер ячейки, м" Style="{StaticResource Muted}" />
            <TextBox Text="{Binding ObjectCellSize, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Размер ячейки предметов" Margin="0,5,0,8" />
            <TextBlock Text="Минимум точек выборки" Style="{StaticResource Muted}" />
            <TextBox Text="{Binding ObjectMinimumPoints, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Минимум точек предмета" Margin="0,5,0,8" />
            <CheckBox Content="Исключить подтверждённые плоскости" IsChecked="{Binding ExcludeObjectPlanes}" FontSize="12" Margin="0,0,0,8" />
        </StackPanel>
        <Button Content="Выделить предметы" Command="{Binding AnalyzeObjectsCommand}" FontSize="12" Margin="0,0,0,10" />
        <CheckBox Content="Цвета и рамка предметов" IsChecked="{Binding ShowObjectCandidates}" FontSize="12" Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding ObjectCandidates}" SelectedItem="{Binding SelectedObjectCandidate}" Background="Transparent" BorderThickness="0" Foreground="#E4ECF4" AutomationProperties.Name="Группы предметов" SelectionChanged="Object_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4">
                <Border DockPanel.Dock="Left" Background="{Binding ColorHex}" Width="10" Height="10" CornerRadius="3" Margin="0,4,7,0" VerticalAlignment="Top" />
                <StackPanel><TextBlock Text="{Binding Label}" FontSize="12" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
            </DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Свойства выбранного предмета →" Command="{Binding InspectCommand}" CommandParameter="Предмет" Margin="0,8,0,0" /></StackPanel></Expander>
        <Expander Header="Дополнительно" Margin="0,18,0,0"><Button Content="Удалить анализ" Command="{Binding ClearStructureCommand}" Style="{StaticResource Danger}" Margin="0,10,0,0"/></Expander>
    </StackPanel></ScrollViewer>
</UserControl>
