<UserControl x:Class="SubTerra.Views.StructureAnalysisPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}"/>
        <Style x:Key="ObjectRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="9"/></Style>
    </ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="0,16,4,8"><StackPanel>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="↶" Style="{StaticResource Ghost}" Width="28" Height="28" MinHeight="28" Padding="0" FontSize="16" Command="{Binding UndoProjectCommand}" ToolTip="{Binding UndoProjectText}" AutomationProperties.Name="Отменить действие"/>
                <Button Content="↷" Style="{StaticResource Ghost}" Width="28" Height="28" MinHeight="28" Padding="0" FontSize="16" Command="{Binding RedoProjectCommand}" ToolTip="{Binding RedoProjectText}" AutomationProperties.Name="Повторить действие"/>
            </StackPanel>
            <TextBlock Text="Структура помещения" Style="{StaticResource Section}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="Проверка классов доступна администратору." Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}"/>

            <TextBlock Text="{Binding StructureCountsText}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding StructureDataText}" Style="{StaticResource Hint}" ToolTip="{Binding StructureSummary}"/><Border Background="#33261F" Padding="10" CornerRadius="7" Margin="0,10,0,0" Visibility="{Binding StructureIsStale, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Сканы изменились. Повторите анализ или отмените изменение." Foreground="#F2C2A8" TextWrapping="Wrap" FontSize="11"/></Border>
            <Grid Margin="0,10,0,4"><TextBlock Text="Допуск плоскости" Style="{StaticResource Hint}"/><TextBlock Text="{Binding StructureTolerance, StringFormat={}{0:F3} м}" HorizontalAlignment="Right" FontSize="11"/></Grid>
            <Slider Minimum=".005" Maximum=".1" TickFrequency=".005" IsSnapToTickEnabled="True" Value="{Binding StructureTolerance}" IsEnabled="{Binding CanAnalyzeStructure}" AutomationProperties.Name="Допуск анализа плоскостей"/>
            <Button Content="Найти поверхности" Command="{Binding AnalyzeStructureCommand}" FontSize="12" Margin="0,5,0,9" ToolTip="Новый анализ заменит прежние классы. Действие можно отменить."/>
            <StackPanel Visibility="{Binding HasStructureAnalysis, Converter={StaticResource BoolVisibility}}">
                <CheckBox Content="Подсветка структуры" IsChecked="{Binding ShowStructure}" FontSize="11" Margin="0,0,0,9"/>
                <WrapPanel Margin="0,0,0,8"><TextBlock Text="● Пол  " Foreground="#61E08C" FontSize="10"/><TextBlock Text="● Стены  " Foreground="#F5B84D" FontSize="10"/><TextBlock Text="● Потолок  " Foreground="#66A6FA" FontSize="10"/><TextBlock Text="● Не определено" Foreground="#BD8CE0" FontSize="10"/></WrapPanel>
                <ListBox ItemsSource="{Binding StructureSurfaces}" SelectedItem="{Binding SelectedStructureSurface}" ItemContainerStyle="{StaticResource ObjectRow}" MaxHeight="160" Background="Transparent" BorderThickness="0" Foreground="#E4ECF4" AutomationProperties.Name="Кандидаты поверхностей">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewText}" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SelectedStructureSurface.Details, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedStructureSurface.Details}" Margin="0,8,0,0"/><StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanReviewStructure}">
                    <TextBlock Text="Класс выбранной поверхности" Style="{StaticResource Hint}"/>
                    <ComboBox ItemsSource="{Binding StructureClasses}" SelectedItem="{Binding SelectedStructureClass}" DisplayMemberPath="Label" Margin="0,5,0,6" AutomationProperties.Name="Класс поверхности"/>
                    <Button Style="{StaticResource Primary}" Content="Подтвердить класс" Command="{Binding ConfirmStructureSurfaceCommand}" FontSize="11"/>
                    <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="Отклонить" Command="{Binding RejectStructureSurfaceCommand}" FontSize="10" Margin="0,0,4,0"/><Button Content="Сбросить класс" Command="{Binding ResetStructureSurfaceCommand}" FontSize="10" ToolTip="Вернуть класс, предложенный алгоритмом, и статус кандидата"/></UniformGrid>
                </StackPanel>
                <Button Style="{StaticResource Ghost}" Content="Удалить анализ" Command="{Binding ClearStructureCommand}" FontSize="11" Margin="0,8,0,0"/>
                <TextBlock Text="Сохраняется в проекте. Правки можно отменить. Площадь контура приблизительная." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
        
    </StackPanel></ScrollViewer>
</UserControl>
