<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SubTerra.Views.SurfacePropertiesPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding SelectedStructureSurface.Title, TargetNullValue=Выберите поверхность}" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Background="#182C31" CornerRadius="7" Padding="10" Margin="0,0,0,12"><TextBlock Text="{Binding SelectedStructureSurface.ReviewText}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2C2A8"/><Style.Triggers><DataTrigger Binding="{Binding SelectedStructureSurface.Review}" Value="Confirmed"><Setter Property="Foreground" Value="#A1E3C5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
        <TextBlock Text="{Binding SelectedStructureSurface.Details}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
        <Button Content="Приблизить поверхность" Command="{Binding FocusStructureSurfaceCommand}" Margin="0,0,0,10"/>
        <TextBlock Text="Предварительный класс подтверждает оператор." Style="{StaticResource Muted}" Margin="0,0,0,10" />
        <StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanReviewStructure}">
            <TextBlock Text="Класс выбранной поверхности" Style="{StaticResource Hint}" />
            <ComboBox ItemsSource="{Binding StructureClasses}" SelectedItem="{Binding SelectedStructureClass}" DisplayMemberPath="Label" Margin="0,5,0,6" AutomationProperties.Name="Класс поверхности" />
            <Button Style="{StaticResource Primary}" Content="Подтвердить класс" Command="{Binding ConfirmStructureSurfaceCommand}" FontSize="12" />
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Content="Отклонить" Style="{StaticResource Danger}" Command="{Binding RejectStructureSurfaceCommand}" FontSize="12" Margin="0,0,4,0" />
                <Button Content="Сбросить класс" Command="{Binding ResetStructureSurfaceCommand}" FontSize="12" ToolTip="Вернуть класс, предложенный алгоритмом, и статус кандидата" />
            </UniformGrid>
        </StackPanel>
        <TextBlock Text="Анализ устарел. Повторите обнаружение перед проверкой." Foreground="#F2C2A8" TextWrapping="Wrap" Visibility="{Binding StructureIsStale, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
