<Window x:Class="SubTerra.Views.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступ администратора" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#111B26" Foreground="#E4ECF4"
        Closing="Window_Closing">
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" Text="Вход администратора" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="Explanation" Text="Войдите, чтобы управлять сканером, сохранять и экспортировать измерения."
                   TextWrapping="Wrap" Foreground="#96AAB9" Margin="0,10,0,22"/>
        <TextBlock Text="Логин" Margin="0,0,0,7"/>
        <TextBox x:Name="LoginBox" Text="admin" Padding="10" FontSize="14" Background="#192634" Foreground="#E4ECF4"
                 BorderBrush="#405363" MaxLength="64" AutomationProperties.Name="Логин администратора"/>
        <TextBlock Text="Пароль" Margin="0,16,0,7"/>
        <PasswordBox x:Name="PasswordBox" Padding="10" FontSize="14" Background="#192634" Foreground="#E4ECF4"
                     BorderBrush="#405363" MaxLength="128" AutomationProperties.Name="Пароль администратора"/>
        <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed">
            <TextBlock Text="Повторите пароль" Margin="0,16,0,7"/>
            <PasswordBox x:Name="ConfirmationBox" Padding="10" FontSize="14" Background="#192634" Foreground="#E4ECF4"
                         BorderBrush="#405363" MaxLength="128" AutomationProperties.Name="Повтор пароля"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#F0BAA5" Margin="0,16,0,0"/>
        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SubmitButton" Content="Войти" Style="{StaticResource Primary}" IsDefault="True" Click="Submit_Click" Margin="0,0,9,0"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена" IsCancel="True"/>
        </Grid>
    </StackPanel>
</Window>
