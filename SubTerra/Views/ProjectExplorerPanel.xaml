<UserControl x:Class="SubTerra.Views.ProjectExplorerPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer Padding="0,4,2,12"><StackPanel>
        <TextBlock Text="Объекты проекта" Style="{StaticResource Section}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
        <Button Content="+ Добавить скан" Click="Add_Click" IsEnabled="{Binding CanManageProject}" Style="{StaticResource Primary}" Margin="0,0,0,14"/>
        <TreeView SelectedItemChanged="Object_Selected" Background="Transparent" BorderThickness="0" Foreground="#E6EEF5" IsEnabled="{Binding CanSelectScanObject}" AutomationProperties.Name="Дерево проекта">
            <TreeViewItem Header="Сканы" IsExpanded="True" ItemsSource="{Binding ScanObjects}"><TreeViewItem.ItemTemplate><DataTemplate><StackPanel>
                <DockPanel><Button DockPanel.Dock="Left" Content="{Binding VisibilityText}" Command="{Binding DataContext.ToggleScanObjectCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" Padding="3" MinHeight="24" Width="24" Margin="0,0,6,0" Style="{StaticResource Ghost}" ToolTip="Видимость скана"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="30,1,0,0"/>
            </StackPanel></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
            <TreeViewItem Header="Поверхности" IsExpanded="False" ItemsSource="{Binding StructureSurfaces}"><TreeViewItem.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
            <TreeViewItem Header="Комнаты и этажи" ItemsSource="{Binding SavedRooms}" IsExpanded="True"><TreeViewItem.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding Plan.AreaSquareMeters, StringFormat=≈ {0:F1} м²}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
            <TreeViewItem Header="Предметы" ItemsSource="{Binding ObjectCandidates}"><TreeViewItem.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
        </TreeView>
        <Button Content="Только выбранный скан / этаж" Command="{Binding IsolateObjectCommand}" Margin="0,10,0,0"/>
        <Button Content="Показать все сканы" Command="{Binding ShowAllObjectsCommand}" Style="{StaticResource Ghost}" Margin="0,6,0,0"/>
        <Button Content="{Binding RoomName}" Command="{Binding InspectCommand}" CommandParameter="Комната" Visibility="{Binding HasRoom, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" ToolTip="Свойства построенной комнаты"/>
        <Border Style="{StaticResource Divider}"/>
        <TextBlock Text="Слои сцены" Style="{StaticResource Label}" Margin="0,0,0,12"/>
        <CheckBox Content="Координатная сетка" IsChecked="{Binding ShowGrid}" Margin="0,0,0,8"/>
        <CheckBox Content="Кандидаты поверхностей" IsChecked="{Binding ShowStructure}" IsEnabled="{Binding HasStructureAnalysis}" Margin="0,0,0,8"/>
        <CheckBox Content="Предметы" IsChecked="{Binding ShowObjectCandidates}" IsEnabled="{Binding HasObjectCandidates}" Margin="0,0,0,8"/>
        <CheckBox Content="Все актуальные комнаты" IsChecked="{Binding ShowAllRooms}" IsEnabled="{Binding HasRoom}" Margin="0,0,0,8"/>
        <CheckBox Content="Границы комнаты" IsChecked="{Binding ShowRoom}" IsEnabled="{Binding RoomPlanVisible}"/>
        <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding SourceBadge}" FontWeight="SemiBold"/><TextBlock Text="Метры · вертикаль Z. Проверьте масштаб по известному расстоянию." Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
        <Expander Header="Размер видимой области" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding DistanceText, StringFormat=X: {0} м}"/><TextBlock Text="{Binding DurationText, StringFormat=Y: {0}}" Margin="0,6,0,0"/><TextBlock Text="{Binding CoverageMetricText, StringFormat=Z: {0}}" Margin="0,6,0,0"/></StackPanel></Expander>
        <Button Content="Модель корпуса · 3 этажа" Command="{Binding LoadCollegeBuildingCommand}" Margin="0,12,0,0"/>
        <Button Content="Далее: обработка →" Command="{Binding SelectSectionCommand}" CommandParameter="Обработка" Style="{StaticResource Ghost}" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
</UserControl>
