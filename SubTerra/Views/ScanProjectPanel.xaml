<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SubTerra.Views.ScanProjectPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SubTerra;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#ACBFCD" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="17" />
            </Style>
            <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Padding" Value="7" />
                <Setter Property="Margin" Value="0,3,4,5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,4,0">
        <StackPanel>
            <StackPanel Margin="0,0,0,6">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsGuest}" Value="True"/><Condition Binding="{Binding IsClipTool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="Для очистки и совмещения нужны права администратора." Style="{StaticResource Muted}"/>
                <Button Content="Войти для редактирования" Command="{Binding RequestAdminAccessCommand}" Style="{StaticResource Ghost}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Visibility="{Binding IsAdministrator, Converter={StaticResource BoolVisibility}}">
            <StackPanel Visibility="{Binding IsAlignmentTool, Converter={StaticResource BoolVisibility}}">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Активный скан перемещается, опорный остаётся на месте. Выберите три и более соответствующие пары, не лежащие на одной прямой." Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding AlignmentTargets}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding AlignmentTargetId}" IsEnabled="{Binding CanEditObject}" Margin="0,8,0,8" AutomationProperties.Name="Опорный скан" />
                    <Button Content="Выбирать точки в 3D" Command="{Binding CoordinatesCommand}" FontSize="12" />
                    <Button Content="Принять точку активного скана" Command="{Binding CaptureAlignmentSourceCommand}" FontSize="12" Margin="0,6,0,0" />
                    <Button Content="Принять опорную точку" Command="{Binding CaptureAlignmentTargetCommand}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding AlignmentSummary}" Style="{StaticResource Muted}" Margin="0,7,0,8" />
                    <CheckBox Content="Уточнить по облаку точек" IsChecked="{Binding RefineAlignment}" IsEnabled="{Binding CanEditObject}" FontSize="12" />
                    <TextBlock Text="Допустимая дистанция совпадения, м" Style="{StaticResource Muted}" Margin="0,7,0,4" />
                    <TextBox Text="{Binding AlignmentDistance, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditObject}" AutomationProperties.Name="Дистанция совмещения в метрах" />
                    <Button Content="Предпросмотр совмещения" Command="{Binding PreviewAlignmentCommand}" FontSize="12" Margin="0,7,0,0" />
                    <Button Content="Очистить опорные пары" Command="{Binding ClearAlignmentPairsCommand}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock Text="Исходники сохраняются. Применённое положение можно отменить; зависимые результаты станут устаревшими. Ошибка выборки не заменяет контроль размеров." Style="{StaticResource Muted}" Margin="0,7,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding IsCleaningTool, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="Сначала предпросмотр, затем применение. Исходные точки остаются в проекте." Style="{StaticResource Hint}" Margin="0,6,0,10" />
            <UniformGrid Columns="2">
                <Button Content="Рамка" Command="{Binding RectangleSelectionCommand}" FontSize="12" Margin="0,0,4,0" />
                <Button Content="Кисть" Command="{Binding BrushSelectionCommand}" FontSize="12" />
            </UniformGrid>
            <CheckBox Content="Оставить выделенное" IsChecked="{Binding KeepScreenSelection}" IsEnabled="{Binding CanEditObject}" FontSize="12" Margin="0,10,0,6" />
            <Grid Margin="0,9,0,0">
                <TextBlock Text="Радиус кисти" Style="{StaticResource Hint}" />
                <TextBlock Text="{Binding BrushRadius, StringFormat={}{0:0} px}" HorizontalAlignment="Right" FontSize="12" />
            </Grid>
            <Slider Value="{Binding BrushRadius}" Minimum="8" Maximum="100" TickFrequency="4" IsSnapToTickEnabled="True" IsEnabled="{Binding CanEditObject}" AutomationProperties.Name="Радиус кисти" />
            <Button Command="{Binding EndScreenSelectionCommand}" Content="Выйти из выделения · Esc" FontSize="12" Margin="0,5,0,6" Visibility="{Binding IsScreenSelecting, Converter={StaticResource BoolVisibility}}" />
            <Expander Header="Область XYZ" Margin="0,12,0,0">
                <StackPanel Margin="0,10,0,0" IsEnabled="{Binding CanEditObject}">
                    <TextBlock Text="Границы в метрах, в системе проекта. Слева минимум, справа максимум." Style="{StaticResource Hint}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="X" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding CleanMinX}" AutomationProperties.Name="Минимум X" />
                        <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding CleanMaxX}" AutomationProperties.Name="Максимум X" />
                        <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding CleanMinY}" AutomationProperties.Name="Минимум Y" />
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Text="{Binding CleanMaxY}" AutomationProperties.Name="Максимум Y" />
                        <TextBlock Grid.Row="2" Text="Z" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding CleanMinZ}" AutomationProperties.Name="Минимум Z" />
                        <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Field}" Text="{Binding CleanMaxZ}" AutomationProperties.Name="Максимум Z" />
                    </Grid>
                    <UniformGrid Columns="2">
                        <Button Content="Оставить" Command="{Binding KeepCleanBoxCommand}" FontSize="12" Margin="0,0,4,0" />
                        <Button Content="Удалить" Command="{Binding RemoveCleanBoxCommand}" FontSize="12" />
                    </UniformGrid>
                    <Button Content="Границы объекта" Command="{Binding ResetCleanBoxCommand}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
            <Expander Header="Плотность и выбросы" Margin="0,12,0,0">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Шаг сетки, м · только облака без граней" Style="{StaticResource Hint}" />
                    <TextBox Text="{Binding VoxelSize}" IsEnabled="{Binding CanVoxelClean}" Margin="0,5,0,6" AutomationProperties.Name="Шаг уменьшения плотности" />
                    <Button Content="Уменьшить плотность" Command="{Binding VoxelCleanCommand}" FontSize="12" />
                    <TextBlock Text="Радиус соседства, м" Style="{StaticResource Hint}" Margin="0,13,0,5" />
                    <TextBox Text="{Binding OutlierRadius}" IsEnabled="{Binding CanEditObject}" AutomationProperties.Name="Радиус поиска соседей" />
                    <TextBlock Text="Минимум соседей (1–64)" Style="{StaticResource Hint}" Margin="0,7,0,5" />
                    <TextBox Text="{Binding MinimumNeighbors}" IsEnabled="{Binding CanEditObject}" AutomationProperties.Name="Минимальное число соседей" />
                    <Button Content="Удалить изолированные точки" Command="{Binding RemoveOutliersCommand}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>
            </Expander>
            <Button Content="Восстановить исходник" Command="{Binding RestoreObjectCommand}" FontSize="12" Margin="0,15,0,0" />
            </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding IsClipTool, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="Срез доступен в режиме облака точек." Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                <Button Content="Показать точки" Command="{Binding PointsCommand}" Style="{StaticResource Ghost}" Margin="0,0,0,10"/>
                <StackPanel IsEnabled="{Binding IsPoints}">
                <StackPanel Margin="0,8,0,0">
                    <CheckBox Content="Включить срез" IsChecked="{Binding ClipEnabled}" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Азимут" />
                        <TextBlock Text="{Binding ClipYaw, StringFormat={}{0:F0}°}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider Value="{Binding ClipYaw, Delay=100}" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Азимут среза" />
                    <Grid>
                        <TextBlock Text="Наклон" />
                        <TextBlock Text="{Binding ClipPitch, StringFormat={}{0:F0}°}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider Value="{Binding ClipPitch, Delay=100}" Minimum="-90" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Наклон среза" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Смещение, м" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ClipOffset, UpdateSourceTrigger=LostFocus}" KeyDown="NumericInput_KeyDown" AutomationProperties.Name="Смещение плоскости" />
                    </Grid>
                    <Slider Value="{Binding ClipOffset, Delay=100}" Minimum="{Binding ClipMinimum}" Maximum="{Binding ClipMaximum}" TickFrequency="{Binding ClipStep}" IsSnapToTickEnabled="True" AutomationProperties.Name="Смещение среза" />
                    <TextBlock Text="Срез меняет только просмотр. Полный скан сохраняется и экспортируется целиком." Style="{StaticResource Muted}" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
