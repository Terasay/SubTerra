<Window x:Class="SubTerra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:views="clr-namespace:SubTerra.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="/Assets/SubTerra.ico" Title="SubTerra — цифровая модель пространства" Width="1440" Height="900" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#0B1218"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI" Foreground="#E4ECF4"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="CornerRadius" Value="9"/></Style>
    </Window.Resources>
    <Border x:Name="ShellFrame" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="16,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
            <Button Command="{Binding ShowWelcomeCommand}" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Padding="0" ToolTip="На стартовый экран" AutomationProperties.Name="На стартовый экран"><StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource AppMark}" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="SubTerra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel></Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionTitle}"/>
                <TextBlock Text="{Binding SaveStateText}" Style="{StaticResource Label}" FontSize="11" FontWeight="Normal" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FileMenuButton" Content="Файл  ▾" Click="OpenMenu_Click" Style="{StaticResource Ghost}" Padding="12,6" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource WorkspaceMenu}">
                            <MenuItem Header="Открыть проект…" Click="Open_Click" IsEnabled="{Binding CanInteract}" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="Новый проект из скана…" Click="Import_Click" IsEnabled="{Binding CanInteract}"/>
                            <Separator/>
                            <MenuItem Header="Сохранить" Click="Save_Click" IsEnabled="{Binding CanSave}" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="Сохранить как…" Click="SaveAs_Click" IsEnabled="{Binding CanSave}" InputGestureText="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem Header="{Binding UndoProjectText}" Command="{Binding UndoProjectCommand}" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="{Binding RedoProjectText}" Command="{Binding RedoProjectCommand}" InputGestureText="Ctrl+Y"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ExportMenuButton" Content="Экспорт  ▾" Click="OpenMenu_Click" Style="{StaticResource Ghost}" Padding="12,6" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource WorkspaceMenu}">
                            <MenuItem Header="{Binding ExportButtonText}" Click="Export_Click" IsEnabled="{Binding CanExport}" ToolTip="Видимые объекты после очистки"/>
                            <MenuItem Header="Реконструкция помещения · PLY" Click="ExportReconstruction_Click" IsEnabled="{Binding CanExportReconstruction}" Visibility="{Binding HasReconstruction, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="Сетка тоннеля · PLY" Click="ExportTunnelMesh_Click" IsEnabled="{Binding CanExportTunnelMesh}" Visibility="{Binding HasTunnelReconstruction, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="Только достройка тоннеля · PLY" Click="ExportTunnelCompletion_Click" IsEnabled="{Binding CanExportTunnelMesh}" Visibility="{Binding HasTunnelReconstruction, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="XYZ-разметка тоннеля · CSV" Click="ExportTunnelLabels_Click" IsEnabled="{Binding CanExportTunnelLabels}" Visibility="{Binding HasTunnelRecognition, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="Войти для экспорта" Command="{Binding RequestAdminAccessCommand}" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ViewMenuButton" Content="Вид  ▾" Click="OpenMenu_Click" Style="{StaticResource Ghost}" Padding="12,6">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource WorkspaceMenu}">
                            <MenuItem Header="Свойства объекта" Command="{Binding InspectCommand}" CommandParameter="Скан" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="Настройки просмотра" Command="{Binding ToggleSettingsCommand}"/>
                            <MenuItem Header="Режим презентации" IsCheckable="True" IsChecked="{Binding IsPresentationMode}" InputGestureText="F11" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}"/>
                            <MenuItem Header="Обучение модели" Command="{Binding OpenTrainingPanelCommand}" Visibility="{Binding IsAdministrator, Converter={StaticResource BoolVisibility}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Click="Access_Click" Content="{Binding AccessButtonText}" IsEnabled="{Binding CanInteract}" Style="{StaticResource Ghost}" Padding="12,6" ToolTip="{Binding AccessLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="Minimize_Click" Style="{StaticResource Ghost}" Width="34" MinHeight="30" Padding="0" AutomationProperties.Name="Свернуть"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE921;"/></Button>
                <Button Click="Maximize_Click" Style="{StaticResource Ghost}" Width="34" MinHeight="30" Padding="0" AutomationProperties.Name="Развернуть"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE922;"/></Button>
                <Button Click="Close_Click" Style="{StaticResource Ghost}" Width="34" MinHeight="30" Padding="0" AutomationProperties.Name="Закрыть"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;"/></Button>
            </StackPanel>
        </Grid></Border>
        <Grid Grid.Row="1" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="0"/><ColumnDefinition/><ColumnDefinition x:Name="RightColumn" Width="0"/></Grid.ColumnDefinitions>
                <DockPanel Grid.ColumnSpan="3" Margin="12,10,12,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource ChromeBrush}" CornerRadius="7" Padding="2" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal">
                            <RadioButton Content="3D" Style="{StaticResource Segment}" Padding="11,6" IsChecked="{Binding Is3DView, Mode=OneWay}" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="3D" GroupName="WorkspaceView"/>
                            <RadioButton Content="{Binding PlanViewLabel}" Style="{StaticResource Segment}" Padding="11,6" IsChecked="{Binding IsPlanView, Mode=OneWay}" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="План 2D" GroupName="WorkspaceView"/>
                            <RadioButton Content="Рядом" Style="{StaticResource Segment}" Padding="11,6" IsChecked="{Binding IsSplitView, Mode=OneWay}" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="Рядом" GroupName="WorkspaceView"/>
                        </StackPanel></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ObjectsButton" Content="{Binding ProjectPanelLabel}" Command="{Binding ToggleProjectPanelCommand}" Style="{StaticResource Ghost}" Padding="12,6" Margin="0,0,6,0" ToolTip="Показать или скрыть объекты проекта"/>
                        <Button x:Name="ToolsMenuButton" Content="Инструменты  ▾" Click="OpenMenu_Click" Style="{StaticResource Ghost}" Padding="12,6">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource WorkspaceMenu}">
                                    <MenuItem Header="Измерить расстояние" Command="{Binding MeasureCommand}"/>
                                    <MenuItem Header="Координаты точки" Command="{Binding CoordinatesCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Очистить скан…" Command="{Binding SelectProcessingToolCommand}" CommandParameter="Очистка" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Совместить сканы…" Command="{Binding SelectProcessingToolCommand}" CommandParameter="Совмещение" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Срез облака…" Command="{Binding SelectProcessingToolCommand}" CommandParameter="Срез" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Поверхности помещения…" Command="{Binding SelectAnalysisToolCommand}" CommandParameter="Поверхности" Visibility="{Binding IsRoomMode, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Сечения тоннеля…" Command="{Binding SelectAnalysisToolCommand}" CommandParameter="Тоннель" Visibility="{Binding IsTunnelMode, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Найти людей…" Command="{Binding SelectAnalysisToolCommand}" CommandParameter="Люди" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Виртуальный сканер…" Command="{Binding SelectSectionCommand}" CommandParameter="Обработка" Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"/>
                                    <Separator/>
                                    <MenuItem Header="План помещения и измерения…" Command="{Binding SelectSectionCommand}" CommandParameter="Результаты" Visibility="{Binding IsRoomMode, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Результаты и метки…" Command="{Binding SelectSectionCommand}" CommandParameter="Результаты" Visibility="{Binding IsTunnelMode, Converter={StaticResource BoolVisibility}}"/>
                                    <MenuItem Header="Измерения и метки…" Command="{Binding SelectSectionCommand}" CommandParameter="Результаты" Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>

            <Border Grid.Row="1" x:Name="LeftPanel" Visibility="Collapsed" Panel.ZIndex="20" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
              <Grid Margin="14,10,14,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Click="CloseSidebar_Click" Content="×" Style="{StaticResource Ghost}" Padding="6,0" MinHeight="26" ToolTip="Скрыть инструменты" AutomationProperties.Name="Скрыть инструменты"/>
                    <TextBlock Text="{Binding TaskPanelTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <DockPanel Margin="0,0,0,12" Visibility="{Binding ShowActiveScanPicker, Converter={StaticResource BoolVisibility}}">
                        <Button DockPanel.Dock="Right" Command="{Binding InspectCommand}" CommandParameter="Скан" Style="{StaticResource Ghost}" Margin="4,0,0,0" Padding="8,5" ToolTip="Свойства активного скана" AutomationProperties.Name="Свойства активного скана"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;"/></Button>
                        <ComboBox ItemsSource="{Binding ScanObjects}" SelectedItem="{Binding SelectedScanObject}" IsEnabled="{Binding CanSelectScanObject}" ToolTip="{Binding SelectedScanObject.Name}" AutomationProperties.Name="Активный скан">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding IsProjectSection, Converter={StaticResource BoolVisibility}}">
                        <views:ProjectExplorerPanel Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                        <ScrollViewer Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"><StackPanel>
                            <Border Style="{StaticResource InsetCard}"><StackPanel><TextBlock Text="Демонстрация LiDAR" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Синтетические данные · виртуальная пещера" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
                            <TextBlock Text="Сцена" Style="{StaticResource Label}" Margin="0,18,0,8"/>
                            <ComboBox x:Name="ScenarioPicker" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="Scenario_SelectionChanged" IsEnabled="{Binding CanChangeScenario}" AutomationProperties.Name="Пространство"/>
                            <TextBlock Text="{Binding SelectedScenario.Description}" Style="{StaticResource Muted}" Margin="0,10,0,14"/>
                            <CheckBox Content="Координатная сетка" IsChecked="{Binding ShowGrid}" Margin="0,0,0,9"/>
                            <CheckBox Content="Маршрут сканера" IsChecked="{Binding ShowRoute}" Margin="0,0,0,9"/>
                            <CheckBox Content="Метки на карте" IsChecked="{Binding ShowMarkers}" Margin="0,0,0,9"/>
                            <CheckBox Content="Скрыть потолок" IsChecked="{Binding CutRoof}" IsEnabled="{Binding IsOverview}" Margin="0,0,0,9"/>
                            <CheckBox Content="Следовать за сканером" IsChecked="{Binding FollowScanner}" IsEnabled="{Binding IsOverview}" Margin="0,0,0,9"/>
                            <CheckBox Content="Тени" IsChecked="{Binding ShowShadows}" IsEnabled="{Binding IsCave}"/>
                        </StackPanel></ScrollViewer>
                    </Grid>
                    <Grid Visibility="{Binding IsProcessingSection, Converter={StaticResource BoolVisibility}}"><views:ScanProjectPanel Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/><views:SimulationPanel Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"/></Grid>
                    <Grid Visibility="{Binding IsAnalysisSection, Converter={StaticResource BoolVisibility}}"><views:StructureAnalysisPanel Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/><StackPanel Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Анализ импортированных сканов" Style="{StaticResource Section}" TextWrapping="Wrap"/><TextBlock Text="Для поиска стен, пола и потолка импортируйте облако точек помещения." Style="{StaticResource Muted}" Margin="0,12,0,12"/><Button Click="Import_Click" Content="Импортировать скан"/></StackPanel></Grid>
                    <ScrollViewer Visibility="{Binding IsResultsSection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <views:RoomPlanPanel Visibility="{Binding IsRoomMode, Converter={StaticResource BoolVisibility}}"/>
                            <StackPanel Visibility="{Binding IsTunnelMode, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,16">
                                <TextBlock Text="Сечения тоннеля" Style="{StaticResource Section}"/>
                                <TextBlock Text="{Binding TunnelSummary}" Style="{StaticResource Muted}" Margin="0,8,0,10"/>
                                <Button Content="Открыть сечение" Command="{Binding SelectWorkspaceViewCommand}" CommandParameter="План 2D" IsEnabled="{Binding HasTunnelSections}" Style="{StaticResource Primary}" Margin="0,0,0,6"/>
                                <Button Content="К анализу тоннеля" Command="{Binding SelectAnalysisToolCommand}" CommandParameter="Тоннель" Style="{StaticResource Ghost}"/>
                            </StackPanel>
                            <views:SessionInspectorPanel/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid></Border>
            <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,12,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="WorkspaceViews"><Grid.ColumnDefinitions><ColumnDefinition x:Name="Scene3DColumn"/><ColumnDefinition x:Name="ViewDividerColumn" Width="0"/><ColumnDefinition x:Name="PlanColumn" Width="0"/></Grid.ColumnDefinitions>
                    <Border x:Name="Scene3DHost" Style="{StaticResource Panel}" ClipToBounds="True" Visibility="{Binding Show3DWorkspace, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel Background="{StaticResource ChromeBrush}" Margin="6,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding TopCommand}" ToolTip="Вид сверху" Style="{StaticResource Ghost}" Padding="8,5" AutomationProperties.Name="Вид сверху"><TextBlock Style="{StaticResource Icon}" Text="&#xE74A;"/></Button>
                                <Button Command="{Binding MeasureCommand}" Content="Измерить" Style="{StaticResource Ghost}" Padding="8,5" ToolTip="Измерить расстояние" AutomationProperties.Name="Измерить расстояние"/>
                                <Button Command="{Binding HomeCommand}" Style="{StaticResource Ghost}" Padding="8,5" ToolTip="Общий вид · Home" AutomationProperties.Name="Общий вид"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;"/></Button>
                            </StackPanel>
                            <Button x:Name="RenderMenuButton" Click="OpenMenu_Click" Style="{StaticResource Ghost}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,5" ToolTip="Отображение 3D" AutomationProperties.Name="Отображение 3D">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RenderLabel}" FontWeight="SemiBold"/><TextBlock Text="▾" Margin="8,0,0,0"/></StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource WorkspaceMenu}">
                                        <MenuItem Header="{Binding SurfaceModeText}" Command="{Binding SurfaceCommand}" IsEnabled="{Binding CanOpenSurface}" ToolTip="{Binding SurfaceModeHint}" ToolTipService.ShowOnDisabled="True"/>
                                        <MenuItem Header="Окраска по высоте" Command="{Binding HeightCommand}"/>
                                        <MenuItem Header="Облако точек" Command="{Binding PointsCommand}"/>
                                        <Separator Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                        <MenuItem Header="Рельеф без RGB" IsCheckable="True" IsChecked="{Binding IsGeometryShading}" Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}"/>
                                        <MenuItem Header="Координатная сетка" IsCheckable="True" IsChecked="{Binding ShowGrid}"/>
                                        <MenuItem Header="Кандидаты поверхностей" IsCheckable="True" IsChecked="{Binding ShowStructure}" Visibility="{Binding HasCurrentStructureAnalysis, Converter={StaticResource BoolVisibility}}"/>
                                        <MenuItem Header="Предметы" IsCheckable="True" IsChecked="{Binding ShowObjectCandidates}" Visibility="{Binding HasObjectCandidates, Converter={StaticResource BoolVisibility}}"/>
                                        <MenuItem Header="Все актуальные комнаты" IsCheckable="True" IsChecked="{Binding ShowAllRooms}" Visibility="{Binding HasRoom, Converter={StaticResource BoolVisibility}}"/>
                                        <MenuItem Header="Границы комнаты" IsCheckable="True" IsChecked="{Binding ShowRoom}" Visibility="{Binding RoomPlanVisible, Converter={StaticResource BoolVisibility}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DockPanel>
                        <Grid Grid.Row="1">                        <h:Viewport3DX x:Name="Viewport" Camera="{Binding Camera}" EffectsManager="{Binding EffectsManager, RelativeSource={RelativeSource AncestorType=Window}}"
                                       BackgroundColor="#0B131B" ShowViewCube="False" ShowCoordinateSystem="False" ModelUpDirection="0,0,1"
                                       EnableSwapChainRendering="False" EnableSSAO="{Binding SsaoEnabled}" SSAOIntensity=".80" SSAOSamplingRadius=".45"
                                       IsShadowMappingEnabled="{Binding ShadowsVisible}" CameraRotationMode="Turntable" RotationSensitivity=".45" ZoomSensitivity=".7"
                                       IsInertiaEnabled="False" UseDefaultGestures="False" Focusable="True" RenderExceptionOccurred="Viewport_RenderExceptionOccurred">
                            <h:AmbientLight3D Color="#4A505A" IsRendering="{Binding SceneLightingVisible}"/>
                            <h:AmbientLight3D Color="{Binding WalkAmbientColor}" IsRendering="{Binding IsWalking}"/>
                            <h:DirectionalLight3D Direction="-.6,.8,-1.6" Color="#D7CABB" IsRendering="{Binding SceneLightingVisible}"/>
                            <h:DirectionalLight3D Direction="1,-.7,-.3" Color="#7C8FA1" IsRendering="{Binding SceneLightingVisible}"/>
                            <h:SpotLight3D Position="{Binding LampCamera.Position}" Direction="{Binding LampCamera.LookDirection}" Color="#FFF0D9" Attenuation="1,.025,.009" Range="36" OuterAngle="96" InnerAngle="48" Falloff="1.4" IsRendering="{Binding IsWalking}"/>
                            <h:PointLight3D Position="{Binding Camera.Position}" Color="#475667" Attenuation="1,.20,.09" Range="10" IsRendering="{Binding IsWalking}"/>
                            <h:SpotLight3D Position="{Binding Camera.Position}" Direction="{Binding Camera.LookDirection}" Color="#FFF0D9" Attenuation="1,.025,.009" Range="36" OuterAngle="96" InnerAngle="48" Falloff="1.4" IsRendering="{Binding ReliefLampVisible}"/>
                            <h:ShadowMap3D Resolution="2048,2048" Bias=".001" Intensity=".55" LightCamera="{Binding ShadowCamera}" IsRendering="{Binding ShadowsVisible}"/>
                            <h:LineGeometryModel3D Geometry="{Binding Grid}" Color="#253B48" Thickness=".5" IsRendering="{Binding GridVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding TunnelAxisGeometry}" Color="#70D7E6" Thickness="2.5" DepthBias="-20" IsRendering="{Binding IsTunnelMode}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding TunnelOtherBranchesGeometry}" Color="#8DA6B6" Thickness="1.5" DepthBias="-20" IsRendering="{Binding IsTunnelMode}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding TunnelDraftGeometry}" Color="#F2A8E0" Thickness="3" DepthBias="-25" IsRendering="{Binding IsTunnelMode}" IsHitTestVisible="False"/>
                            <h:MeshGeometryModel3D Geometry="{Binding TunnelCompletedGeometry}" Material="{Binding TunnelCompletionMaterial}" IsRendering="{Binding TunnelCompletionVisible}" CullMode="None" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding TunnelRecognitionGeometry}" Color="White" Size="3,3" Figure="Ellipse" DepthBias="-20" IsRendering="{Binding TunnelRecognitionVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding TunnelObjectOutline}" Color="#FFF0A0" Thickness="2" DepthBias="-30" IsRendering="{Binding TunnelRecognitionVisible}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding TunnelAxisNodes}" Color="#B5F3FF" Size="7,7" Figure="Ellipse" IsRendering="{Binding IsTunnelMode}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding TunnelSectionGeometry}" Color="#FAD582" Thickness="3" DepthBias="-25" IsRendering="{Binding HasTunnelSections}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding Cloud}" Color="White" Size="2,2" Figure="Ellipse" IsRendering="{Binding IsPoints}" IsHitTestVisible="{Binding IsPicking}" HitTestThickness="6"/>
                            <h:LineGeometryModel3D Geometry="{Binding PeopleProposedOutline}" Color="#F5B84D" Thickness="1.5" IsRendering="{Binding PersonBoxesVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding PeopleConfirmedOutline}" Color="#A1E3C5" Thickness="1.5" IsRendering="{Binding PersonBoxesVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding PeopleRejectedOutline}" Color="#E78D8D" Thickness="1.5" IsRendering="{Binding PersonBoxesVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding PersonOutline}" Color="#F1F6FA" Thickness="3" IsRendering="{Binding PersonBoxesVisible}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding CloudOnly}" Color="White" Size="2,2" Figure="Ellipse" IsRendering="{Binding ImportedMeshVisible}" IsHitTestVisible="{Binding IsPicking}" HitTestThickness="6"/>
                            <h:MeshGeometryModel3D Geometry="{Binding Surface}" Material="{Binding SurfaceMaterial}" IsRendering="{Binding IsSurface}" IsThrowingShadow="True" CullMode="None" IsHitTestVisible="{Binding IsPicking}"/>
                            <h:ItemsModel3D ItemsSource="{Binding TexturedMeshParts}" IsRendering="{Binding ImportedMeshVisible}" IsHitTestVisible="{Binding IsPicking}"><h:ItemsModel3D.ItemTemplate><DataTemplate>
                                <h:MeshGeometryModel3D Geometry="{Binding Geometry}" Material="{Binding Material}" CullMode="{Binding CullMode}" IsTransparent="{Binding IsTransparent}" IsThrowingShadow="True"/>
                            </DataTemplate></h:ItemsModel3D.ItemTemplate></h:ItemsModel3D>
                            <h:MeshGeometryModel3D Geometry="{Binding FloorSurface}" Material="{Binding FloorMaterial}" IsRendering="{Binding IsCave}" IsThrowingShadow="True" CullMode="None" IsHitTestVisible="{Binding IsPicking}"/>
                            <h:MeshGeometryModel3D Geometry="{Binding DampSurface}" Material="{Binding DampMaterial}" IsRendering="{Binding IsCave}" IsThrowingShadow="True" CullMode="None" IsHitTestVisible="{Binding IsPicking}"/>
                            <h:LineGeometryModel3D Geometry="{Binding Route}" Color="#81C7B4" Thickness="1.4" IsRendering="{Binding RouteVisible}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding Markers}" Color="#FFCF67" Size="9,9" Figure="Ellipse" IsRendering="{Binding MarkersVisible}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding Scanner}" Color="#E1FFB3" Size="12,12" Figure="Ellipse" IsRendering="{Binding ScannerVisible}" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding ScannerHeading}" Color="#E1FFB3" Thickness="2" IsRendering="{Binding ScannerVisible}" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding InspectionPoints}" Color="#9DEAFF" Size="9,9" Figure="Ellipse" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding MeasurementLine}" Color="#9DEAFF" Thickness="2" IsHitTestVisible="False"/>
                            <h:PointGeometryModel3D Geometry="{Binding AnnotationGeometry}" Color="#FFAA62" Size="10,10" Figure="Ellipse" IsHitTestVisible="False"/>
                            <h:LineGeometryModel3D Geometry="{Binding ClipPlaneGuide}" Color="#8DABD2" Thickness="1" IsRendering="{Binding ClipGuideVisible}" IsHitTestVisible="False"/>
